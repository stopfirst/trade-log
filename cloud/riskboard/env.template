# 시장 리스크 보드(riskboard) 설정 — 비워 두면 기본값.
# 텔레그램은 /opt/trade-alert/.env 의 TELEGRAM_BOT_TOKEN · TELEGRAM_CHAT_ID 를 그대로 씁니다.
# 다른 방(채널)으로 받고 싶을 때만:
# RB_CHAT_ID=
# 장중 확인 간격(분), 단계 하향 확인 횟수(5분×3=15분), TRIGGER 지속 알림(분), 마감 보고(0이면 끔)
# RB_POLL_MIN=5
# RB_DOWN_CONFIRM=3
# RB_PERSIST_MIN=10
# RB_CLOSE_REPORT=1
# 마감 보드 시각(ET)
# RB_CLOSE_AT=16:55
# 재진입 후보 알림(TRIGGER 뒤 VIX/3M 첫 1 미만 종가, 0이면 끔), 기다리는 최대 거래일
# RB_REENTRY=1
# RB_REENTRY_MAXDAYS=60
# 고장 알림: 시세·전송 연속 실패 횟수(0이면 끔)
# RB_FAIL_ALERT=3
# 단계 기준값
# RB_NEAR_BW=0.95
# RB_BW=1.0
# RB_TENSION_VVIX=115
# RB_TENSION_VIXPCT=15
# RB_FRACTURE_VVIX=110
# RB_FRACTURE_VVIXPCT=20
# RB_FRACTURE_SPX=-1.0
# RB_TRIGGER_VIX=28
# RB_TRIGGER_VIXPCT=20
# RB_TRIGGER_SPX=-2.0
# RB_TRIGGER_VVIX=120
# RB_TRIGGER_3M=-3
# 핵심 신호 MOVE: MOVE 전일비 ≥ +%
# RB_MOVE_PCT=10
# RB_UP_CONFIRM=2        # 1.2.3: TENSION·FRACTURE 상향 확인 횟수(1=즉시)
# RB_STALE_MIN=30        # 1.2.3: 장중 VIX 시세가 이 분 넘게 그대로면 단계 판단 건너뜀

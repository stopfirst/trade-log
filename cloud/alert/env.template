# 매매일지 텔레그램 손실 한도 알림 설정 (trade-alert 1.0.0)
# 이 파일은 이 서버에만 둡니다. 채팅·GitHub·사진으로 보내지 마세요.
# 편집: sudo nano /opt/trade-alert/.env   저장: Ctrl+O, Enter   종료: Ctrl+X
#
# [1] Supabase (키움 수집기 .env와 같은 3줄). 설치 스크립트가 /opt/kiwoom-collector/.env에서
#     자동으로 복사했다면 그대로 두세요.
SUPABASE_URL=https://ktndayhrlhrlxtkirrvx.supabase.co
SUPABASE_KEY=여기에_붙여넣기
KW_COLLECTOR_TOKEN=여기에_붙여넣기
#
# [2] 텔레그램 (BotFather가 준 토큰, --find-chat 으로 확인한 대화방 번호)
TELEGRAM_BOT_TOKEN=여기에_붙여넣기
TELEGRAM_CHAT_ID=여기에_붙여넣기
#
# [3] 알림 규칙 (비워 두면 기본값)
# ALERT_THRESHOLDS=50,80,100     # 한도 대비 % 도달 시 각 1회(기간마다)
# LOSS_STREAK_N=3                # 연속 손실 N회 알림 (0 = 끔)
# LOSS_STREAK_REPEAT=1           # 1: N회 이후 손실마다 다시 알림 / 0: 연속 구간당 1회
# INCLUDE_UNREALIZED=0           # 1: 보유 평가손익(미실현)도 합산
# DAILY_SUMMARY=1                # 미국 장 마감 후 일일 요약 1회 (0 = 끔)
# DAILY_SUMMARY_TIME_ET=16:15    # 요약 시각(미국 동부, 평일)
# ALERT_MARKETS=auto             # auto | US | HL | US,HL
#
# [4] 확인 주기 (초)
# CHECK_ACTIVE_SEC=60            # 미국 동부 04:00–20:00 평일
# CHECK_IDLE_SEC=600             # 그 외
# HL_ALWAYS_ACTIVE=0             # 1: 하이퍼리퀴드가 있으면 항상 60초 주기
#
# [5] 앱 값 대신 쓸 값 (보통 비워 둠 → 앱 설정 사용)
# US_LIMITS_PCT=2,5,10           # 하루,주,달 % (빈칸 = 미설정)
# HL_LIMITS_PCT=
# US_ACCOUNT_BASIS=              # 달러. 비우면 키움 총 계좌금액 → 앱 계좌 기준액
# HL_ACCOUNT_BASIS=              # 비우면 하이퍼리퀴드 BALANCE → 앱 계좌 기준액
# HL_LIVE_BALANCE=1              # 0: 하이퍼리퀴드 잔고를 직접 조회하지 않음

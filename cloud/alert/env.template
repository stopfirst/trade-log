# TELEGRAM_HTML=1
#
# [즉시 복기 2.6.0] HL 포지션 청산 때 텔레그램으로 '📝 BTC 롱 청산 · +$120 (+0.6R) · 복기' + [규칙 준수][규칙 위반][나중에] 버튼.
#   [규칙 위반] → 위반 항목 칩(앱 체크리스트와 같음) + [완료]. 답은 Supabase quick_reviews(alert9.sql 필요)에 저장 → 앱 v37이 그 거래 복기에 반영
#   (앱에서 이미 복기한 거래는 앱 기록 유지). alert9.sql이 없으면 로그 1회 후 질문 안 함(손실 한도 알림은 그대로). 0 = 끔.
#   켜져 있으면 서비스가 텔레그램 버튼 응답을 받습니다(getUpdates) — --find-chat은 서비스를 멈춘 뒤 실행.
# QUICK_REVIEW=1
#
# [현물 포함 분모 2.7.0] HL 손실 한도 분모(전일·기간 시작 직전 마감, 현재 기준액)에 현물 평가액(UBTC 등)을 더함 — 앱 v67과 같은 기준
#   마감 현물 = (지금 수량 − 마감 뒤 순매수) × 마감 시각 봉 시가. 시세를 못 받으면 그 회차·그날은 USDC만. 0 = 끔(예전처럼 USDC만).
# SPOT_IN_BASIS=1
#
# [손실한도 판정 v1.6] 주·월 한도 분모 = 기간 시작 직전 마감 잔액 (trade-alert 2.4.0, 앱 v31과 같음 · 새 SQL 없음, alert5.sql 그대로)
#   기간 시작 = max(이번 주 월요일·이번 달 1일, RISK_START_DATE). 분모 = 그 직전 마감 잔액(acct_snapshots, 7일 이내·> 0; HL UTC 날짜, US 미국 마감일)
#   → 없으면 현재 기준액. 하루 한도(전일 마감)와 같은 방식. 기간 중 입출금은 분모를 바꾸지 않음. 설정할 값 없음.
#
# [손실한도 판정 v1.5] 주·월 한도와 연속 손실일 = 실현손익 기준 (앱과 같음, Supabase에 alert5.sql 필요 — 없으면 v1.4 방식)
#   주·월 % = 이번 주(월요일 시작)·이번 달 실현손익 합(수수료·펀딩 포함) ÷ 현재 기준액(HL BALANCE / 키움 주식 평가 + USD 예수금).
#   연속 손실일 = 그날 실현손익 ÷ 직전 마감 ≤ −STREAK_LOSS_PCT. 입출금은 손실로 잡지 않고, 미실현 포함 변동은 알림 '참고' 줄로만.
#   HL 주·월 경계 = UTC(월요일·1일 KST 09:00). 설정할 값 없음. DAY_LIMIT_BASIS=equity면 하루·주·월 모두 자산 변화(v1.2/v1.4).
#
# [손실한도 판정 v1.4] 한도 기준일 (선택) — 이 날짜 이전 손익은 하루·주·월 합계와 연속 손실일에서 뺍니다.
#   HL = 그날 UTC 00:00(KST 09:00)부터, 미국주식 = 그 날짜(미국 동부) 거래일부터(= 직전 거래일 16:00 ET, 한국 새벽 05/06시).
#   기준일 전 손실로 이미 걸린 중단은 해제됩니다(텔레그램 안내 1회). 비우면 기준일 없음(v1.3 그대로). 앱 설정의 '한도 기준일'과는 별개 설정.
#   (2.5.0) 미래 날짜도 됩니다: 지금 걸린 중단은 바로 전부 해제, 그 날 전까지는 판정·알림 없이 기록만(요약에 'MM/DD부터 적용').
# RISK_START_DATE=2026-10-26     # YYYY-MM-DD
#
# [손실한도 판정 v1.3] 하루 손실 한도 = 앱과 같은 기준 (Supabase에 alert3.sql 필요, 없으면 v1.2 방식으로 동작)
#   하루 % = 오늘 실현손익(수수료·펀딩 포함) ÷ 직전 마감 잔액(없으면 현재 기준액). HL 하루 = UTC 00:00(KST 09:00) 경계.
#   미실현 포함 자산 변화는 알림에 '참고' 한 줄로만. 주·월·연속 손실은 v1.5(위), 재시작 규칙은 아래 v1.2 그대로.
# DAY_LIMIT_BASIS=realized       # realized(기본) | equity = v1.2처럼 하루도 자산 변화(실현+미실현) 기준
#
# [손실한도 판정 v1.2] 아래는 모두 선택 — 앞의 # 를 지우고 값을 바꾸면 적용(비워 두면 기본값)
# 미국주식(키움)과 하이퍼리퀴드는 각자 계좌 순자산(실현+미실현, 수수료·펀딩 포함, 입출금 제외)으로 따로 판정합니다.
# RISK_DAY_PCT=3                 # 하루 손실 한도 % (v1.3: 분모 × % = 한도 금액) → 도달 즉시 그날 끝까지 신규 진입 중단
# RISK_WEEK_PCT=6                # 주 한도 % → 마감 판정 시 다음 거래일~그 주 끝까지 / 장중 도달 시 그날 끝까지
# RISK_MONTH_PCT=10              # 달 한도 % → 마감 판정 시 다음 거래일~그 달 끝까지 / 장중 도달 시 그날 끝까지
# US_RISK_PCT=3,6,10             # 미국주식만 따로(하루,주,달 · 0 = 끔)
# HL_RISK_PCT=3,6,10             # 하이퍼리퀴드만 따로
# STREAK_LOSS_PCT=0.5            # 하루 자산 변화가 이 % 이하로 떨어진 날만 '손실일' (거래 없는 날은 건너뜀)
# STREAK_DAYS=3                  # 연속 손실일 N일이면 (0 = 끔)
# STREAK_STOP_DAYS=1             # 다음 N거래일 신규 진입 중단 (1–2 권장)
# RESTART_RISK_FACTOR=0.5        # 중단이 끝난 뒤 첫 거래일 1회 위험 배수(앱 포지션 계산기에 반영)
# ALERT_THRESHOLDS=50,80         # 한도의 몇 %에서 미리 알림(기간마다 1회, 0 = 끔)
# RISK_CHECK_SEC=60              # 확인 주기(초, 60–300). HL이 있으면 항상 이 주기
# RISK_IDLE_SEC=300              # 미국주식만 있을 때 장외 시간 확인 주기
# RISK_PUSH_MIN=5                # 변화가 없을 때 앱 표시값(손익 %) 갱신 간격(분)
# US_FLOW_MIN_USD=50             # 미국주식 입출금 추정 최소 금액(매매로 설명 안 되는 예수금 변화)
# US_STALE_MIN=20                # 키움 스냅샷이 이 분보다 오래되면 앱·요약에 '오래된 값' 표시
# US_EXTRA_HOLIDAYS=             # NYSE 임시 휴장일 추가(YYYY-MM-DD,YYYY-MM-DD)
# HL_ADDRESS=                    # 비우면 앱에 저장한 HL 자동 수집 주소 사용
# ANCHOR_MAX_GAP_MIN=20          # 하루 경계 직전 관측을 시작 자산으로 쓰는 최대 간격(분)
# ALERT_MARKETS=auto             # auto | US | HL | US,HL
# DAILY_SUMMARY=1                # 미국 장 마감 후 요약 1회 (0 = 끔)
# DAILY_SUMMARY_TIME_ET=16:15    # 요약 시각(미국 동부, 거래일)
# [매일 복기 알림 2.8.0] 어제 거래 중 일지 빈 칸(진입 근거·스탑 이유·손익비·가격 반응·타임프레임)을 매일 한 번 텔레그램으로. Supabase에 alert11.sql 필요.
# REVIEW_REMIND=1                # 0 = 끔
# REVIEW_REMIND_AT=09:30         # 한국 시간 HH:MM (HL 하루 마감 09:00 · 미국 장 마감 뒤)
# [서버 백업 2.9.0] 매일 06:40 KST(trade-alert-backup.timer)에 Supabase의 내 일지·서버 기록을 gzip JSON으로 이 서버에 보관. Supabase에 alert13.sql 필요.
#   지금 한 번: sudo systemctl start trade-alert-backup ; 목록: sudo -u tradealert node --env-file=/opt/trade-alert/.env /opt/trade-alert/src/backup.mjs --list
# BACKUP_DIR=/opt/trade-alert/backups   # 바꾸면 trade-alert-backup.service 의 ReadWritePaths도 같이 바꿔야 함
# BACKUP_KEEP_DAYS=30                   # 이 일수보다 오래된 백업 삭제(최신 3개는 항상 남김)
# BACKUP_PHOTOS=1                       # 0 = 차트 사진(data:image) 빼고 저장(용량 작음, 사진은 복원 안 됨)
# BACKUP_NOTIFY=fail                    # fail = 실패 때만 텔레그램 · always = 매일 결과 · 0 = 끔
# [존 알림 2.10.0] flow-chart(stopfirst.github.io/flow-chart) 존 터치 알림 — BB+FVG(가까운 2개)·OB 백도식(방향별 최근 1개)에 가격이 닿으면 텔레그램 1회.
#   존 계산 = flow-chart와 같은 코드·같은 봉(1분마다 최근 봉만 받음). 같은 존은 한 번만(재시작해도), 존이 무효화되면 기록 정리. 조용한 시간 없음. 새 SQL 없음.
#   켜고 끄기: ZONE_ALERT=1(켬) 또는 텔레그램 /zones on · /zones off · /zones status (텔레그램으로 바꾼 값이 우선, 여기 값을 바꾸면 다시 여기 값).
#   지금 존 목록(보내지 않음): sudo -u tradealert node --env-file=/opt/trade-alert/.env /opt/trade-alert/src/alert.mjs --zones-dry
# ZONE_ALERT=0
# ZONE_SYMBOLS=BTC,ETH
# ZONE_TF=1h              # 15m | 1h | 4h
# ZONE_KINDS=bbfvg,ob     # bbfvg | ob | bbfvg,ob
# ZONE_CHECK_SEC=60       # 확인 주기(초, 30–600)
# ZONE_BARS=100           # 차트의 '봉 개수'(60·100·150·200)와 같게 — 워밍업 260봉은 자동으로 더 받음
# ZONE_SOURCE=auto        # auto = flow-chart와 같은 순서(Binance 선물 → Binance 현물 → Hyperliquid) · hl = Hyperliquid만 · binance = Binance만
# ZONE_COMMANDS=1         # 0 = 텔레그램 /zones 명령 받지 않음
# [복수매매 알림 2.11.0] 손실 청산 뒤 감정 진입(복수매매)을 텔레그램으로 바로 경고. 기본 켜짐. 주문을 막지는 않음(알림만).
#   1) 마지막 손실 청산 → 쿨다운(분) 이내(정각 포함) 새 진입 = '[복수매매 의심]' (직전 손실 종목·손익·경과 분)
#   2) 미국주식: 손절한 날(미국 장 마감 16:00 ET 기준 거래일) 그 손절 종목과 다른 종목 매수 = 별도 경고 + [미리 정한 가격] [강해 보여서] 버튼
#   3) 같은 날(HL UTC 00:00 = KST 09:00 / US 16:00 ET) 연속 손실 청산 N회(2.15.0, 이익 청산이면 0으로) = '오늘은 여기까지' 1회, 그 뒤 그날 진입마다 위반 경고
#   4) 손실 직후(쿨다운 안 또는 같은 날 그 손실 뒤 첫 진입) 진입의 위험이 직전 손실 거래보다 크면 강한 경고(HL 스탑 주문 있으면 스탑 기준, 없으면 명목)
#   손실 = 그 거래(포지션 0→0) 누적 실현손익(수수료·HL 펀딩 포함) < 0. 같은 진입은 한 번만(재시작해도). 기록 = Supabase alert15.sql(없으면 텔레그램만).
#   지난 체결로 몇 건 나왔을지(보내지 않음): sudo -u tradealert node --env-file=/opt/trade-alert/.env /opt/trade-alert/src/alert.mjs --revenge-dry --from 2026-10-01 --to 2026-10-31
# REVENGE_ALERT=1            # 0 = 전부 끔
# REVENGE_COOLDOWN_MIN=15    # 손실 청산 뒤 이 분 이내(정각 포함) 진입 = 복수매매 의심 (0 = 이 규칙 끔, 최대 240)
# DAILY_LOSS_STREAK_MAX=3    # 같은 날 연속 손실 청산 이 횟수 = 오늘은 여기까지 (0 = 끔) · 셈 방식은 아래 DAILY_LOSS_STREAK_MODE
# REVENGE_US_SWITCH=1        # 0 = 미국주식 손절 후 다른 종목 매수 경고·버튼 끔
# REVENGE_RISK_UP=1          # 0 = 손실 직후 위험 증가 경고 끔
# REVENGE_MIN_LOSS_USD=0     # 이 금액 이하 손실(예: −$0.50)은 손실로 안 봄 (기본 0 = 앱과 같은 정의)
# [방향 전환 알림 2.13.0] 하이퍼리퀴드 포지션이 롱↔숏으로 바뀌면 텔레그램 '[방향 전환 의심]' 즉시 경고(HIP-3 dex 코인 포함). 기본 켜짐. 주문을 막지는 않음(알림만).
#   1) 한 주문이 기존 포지션을 넘어 반대 포지션을 엶(reduce-only 아닌 반대 주문, HL 체결 'Long > Short'/'Short > Long')
#   2) 포지션을 0으로 청산한 뒤 FLIP_WINDOW_MIN분 안(정각 포함) 다른 주문으로 반대 방향 진입
#   메시지: 코인·이전/현재 방향·수량·체결가·시각(KST)·주문 oid·reduce-only 여부(HL 주문 조회) + 'Positions 탭 Close로만 청산' 안내.
#   같은 주문은 한 번만(재시작해도). 기록 = Supabase alert17.sql(없으면 텔레그램만). 지난 체결로 보기(보내지 않음):
#   sudo -u tradealert node --env-file=/opt/trade-alert/.env /opt/trade-alert/src/alert.mjs --flip-dry --from 2026-10-01 --to 2026-10-31
# FLIP_ALERT=1         # 0 = 끔
# FLIP_WINDOW_MIN=5    # 청산 뒤 이 분 이내 반대 진입 = 방향 전환 의심 (0 = 이 규칙 끔, 한 주문 반전은 그대로 · 최대 60)
# [복기 알림 단타 제외 2.14.0] 매일 복기 알림(REVIEW_REMIND_AT)에서 '단타'는 빈 칸 알림에서 뺌(앱 v121과 같은 판정). 기본 켜짐.
#   단타 = 끝난 거래의 가장 긴 0→0 왕복(첫 진입~그 왕복 청산, 수집 거래는 왕복 1번) < 앱 설정 '단타 기준 · 분'(설정 → 계좌 → 단타). 앱에 값이 없으면 SCALP_MIN(기본 30).
#   그래도 남김: 규칙 위반(저장한 위반·거래 중단 중 진입·복수매매 의심·연패 후 진입·위험 키움·갈아타기 '강해 보여서') · 손익비 기준 미달 · 포지션/총 오픈 위험 초과 · 실현 R < −1.
#   메시지에 '단타 n건 제외' 한 줄. 단타만 있는 날(남은 게 빈 칸 없는 예외 단타뿐)은 안 보냄.
#   판정 데이터 = Supabase alert18.sql(review_gaps v12). 없으면 예전처럼 단타도 알림 + 로그 WARN 1회.
#   미리 보기(보내지 않음): sudo -u tradealert node --env-file=/opt/trade-alert/.env /opt/trade-alert/src/alert.mjs --remind-dry --day 2026-11-04
# SCALP_MIN=30         # 0 = 단타 제외 끔(2.13.0까지와 같음) · 1~1440 정수(분) · 앱 설정 값이 있으면 앱 값이 우선
# [오늘은 여기까지 연속 2.15.0] 복수매매 '오늘은 여기까지'(DAILY_LOSS_STREAK_MAX, 기본 3)를 '같은 날 손실 청산 횟수'에서 '같은 날 연속 손실 청산'으로.
#   같은 하루(HL UTC 00:00 = KST 09:00 / US 16:00 ET) 안에서 청산 순서대로: 손실 +1 · 이익 청산(순손익 > 0, 수수료·펀딩 포함) 0으로 · 순손익 정확히 0은 그대로.
#   N회 도달 = '🛑 [오늘은 여기까지] … 오늘 연속 손실 3회' 1회, 그 뒤 그날 진입마다 '⛔ [오늘은 여기까지 위반]'(도달 뒤 이익 청산이 와도 그날은 계속).
#   매일 복기 알림의 단타 예외 '3연패 후 진입'(앱 설정 v99MaxLoss)도 같은 셈. 앱 쪽 같은 변경은 앱 v124.
#   예전(2.14.0까지, 이익이 끼어 있어도 그날 손실 3번째에서)으로: DAILY_LOSS_STREAK_MODE=count → sudo systemctl restart trade-alert
# DAILY_LOSS_STREAK_MODE=consecutive   # consecutive = 연속(기본) · count = 횟수(2.14.0까지)
# [탄창 하위계정 2.16.0] HL 하위계정 '탄창'(매일 09:00 KST에 계좌 2%만 넣고 그 계정으로만 거래) — 앱 v123과 같은 규칙. 기본 켜짐(탄창이 정해졌을 때만 동작).
#   탄창 목록 = 앱 설정 → 계좌·위험 → '거래용 하위계정 (탄창)'(Supabase alert20.sql이 읽어 줌) → 앱에 없으면 HL_SUBS. Scalping(0x2b4f…eea9)·앱 제외 목록은 항상 뺌.
#   손실 한도(하루·주·월) 분모 = 주계정 마감 + 탄창 마감(HL portfolio 근삿값), 실현손익 = 주계정 + 탄창 체결·펀딩, 주↔탄창 이체 = 내부 이동(입출금 아님).
#   복수매매·방향 전환·즉시 복기도 탄창 체결 포함. Supabase alert20.sql = 앱 설정 읽기 + pg_cron이 탄창 체결·펀딩도 수집(없으면 HL_SUBS만, 서버가 HL에서 직접 읽음).
#   알림(각 1회): 🧯 탄창 소진(잔고 < 목표 10%, 그날 탄창 체결 뒤) · ⚠️ 장중 재충전(그날 첫 탄창 체결 뒤 주계정→탄창 이체) · ⚠️ 금고에서 거래(주계정 새 진입) ·
#   🔔 09:00 점검(09:10 KST 뒤 첫 확인에 탄창 잔고가 목표 = 직전 마감 합산 × 2%와 ±10% 넘게 다르면).
#   오늘 탄창 보기(보내지 않음): sudo -u tradealert node --env-file=/opt/trade-alert/.env /opt/trade-alert/src/alert.mjs --mag-dry
# MAG=1                 # 0 = 탄창 기능 전부 끔(2.15.0처럼 주계정만)
# HL_SUBS=              # 앱 설정이 없을 때 쓸 탄창 주소(0x… 쉼표로, 최대 5) · 비우면 앱 설정만
# MAG_PCT=2             # 앱에 '하루 탄창 크기 %'가 없을 때 목표 %
# MAG_EMPTY_ALERT=1     # 0 = 탄창 소진 알림 끔 (기준 MAG_EMPTY_PCT=10 % of 목표)
# MAG_REFILL_ALERT=1    # 0 = 장중 재충전 알림 끔
# MAG_VAULT_ALERT=1     # 0 = 금고(주계정)에서 거래 알림 끔
# MAG_OPEN_ALERT=1      # 0 = 09:00 탄창 점검 끔 (MAG_OPEN_CHECK_MIN=10 → 09:10 KST 뒤 · 허용 MAG_OPEN_TOL_PCT=10 %)

# 키움 클라우드 수집기 설정 (v11) — 이 파일은 이 서버에만 둡니다. 채팅·GitHub·사진으로 보내지 마세요.
# 편집: sudo nano /opt/kiwoom-collector/.env   저장: Ctrl+O, Enter   종료: Ctrl+X
#
# [1] 매매일지 앱 → 설정 → 키움 클라우드 수집 → '수집기 토큰 만들기'를 누르면
#     아래 세 줄이 그대로 표시됩니다. 세 줄을 지우고 앱에서 복사한 세 줄을 붙여넣으세요.
SUPABASE_URL=https://ktndayhrlhrlxtkirrvx.supabase.co
SUPABASE_KEY=여기에_붙여넣기
KW_COLLECTOR_TOKEN=여기에_붙여넣기
#
# [2] 키움 REST API 값 (App Key는 이 서버 고정 IP로 발급받은 것)
#     KIWOOM_ACCOUNT는 PC 서버 .env에 적은 것과 "똑같은 형식"으로 적으세요
#     (하이픈 유무가 다르면 다른 계좌로 인식되어 기존 기록과 합쳐지지 않습니다).
KIWOOM_APP_KEY=여기에_붙여넣기
KIWOOM_SECRET=여기에_붙여넣기
KIWOOM_ACCOUNT=여기에_붙여넣기
#
# [3] 선택 (보통 그대로 두세요)
# KW_SESSION_INTERVAL_SEC=60      # 미국 동부 04:00–20:00 평일 (30–600)
# KW_OFFHOURS_INTERVAL_SEC=900    # 그 외 평일 (300–1800)
# KW_WEEKEND_INTERVAL_SEC=1800    # 주말 (600–3600)
# KW_PRICE_PUSH_MIN=10            # 시세만 바뀐 경우 전송 간격(분)
# KW_CASH_TTL_SEC=55              # USD 예수금(ust21160) 조회 간격(초, 30–3600)
# KW_CASH_DISABLED=1              # 예수금 조회 끄기
